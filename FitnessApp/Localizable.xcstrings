        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein 7-Tage-Schnitt liegt seit einer Weile bei etwa %@. Plateaus sind normal; ein paar Dinge lohnen einen Blick:"
          }
        }
      }
    },
    "Your 7-day average passed %@ on %@. That's a real change, not a good morning." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu media de 7 días bajó de %@ el %@. Es un cambio real, no una buena mañana."
