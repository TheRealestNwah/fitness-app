          }
        }
      }
    },
    "Start with one meal a day. Favourite meals and copy-yesterday make it a two-tap habit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una comida al día. Las comidas favoritas y copiar de ayer lo convierten en un hábito de dos toques."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang mit einer Mahlzeit pro Tag an. Lieblingsmahlzeiten und „Von gestern kopieren“ machen daraus eine Zwei-Tipp-Gewohnheit."
          }
        }
      }
    },
