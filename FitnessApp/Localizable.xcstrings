    "Barcode %@ wasn't in the database. Copy the numbers from the label and this food will be found instantly next time you scan it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código %@ no estaba en la base de datos. Copia los valores de la etiqueta y la próxima vez que lo escanees se encontrará al instante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Barcode %@ war nicht in der Datenbank. Übertrag die Werte vom Etikett, dann wird das Lebensmittel beim nächsten Scan sofort gefunden."
          }
        }
      }
    },
    "Barcode number" : {
      "localizations" : {
