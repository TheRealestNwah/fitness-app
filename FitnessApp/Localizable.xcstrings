    },
    "Your 7-day average has stayed around %@. Plateaus are normal; a few things worth checking:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu media de 7 días se ha mantenido en torno a %@. Los estancamientos son normales; conviene revisar algunas cosas:"
