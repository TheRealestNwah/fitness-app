    "About %@ above resting for your weight. Enter your watch's number instead if you have one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unas %@ por encima del reposo para tu peso. Si tienes el dato de tu reloj, introdúcelo en su lugar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %@ über dem Ruhewert für dein Gewicht. Trag lieber den Wert deiner Uhr ein, wenn du ihn hast."
          }
        }
      }
    },
    "About %lld kcal for a %@ %@. Change it if you know better. It counts today and keeps your streak; tap it in the diary later to fill in the details." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unas %lld kcal (%@, %@). Cámbialo si lo sabes mejor. Cuenta para hoy y mantiene tu racha; tócalo luego en el diario para completar los detalles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %lld kcal (%@, %@). Ändere es, wenn du es genauer weißt. Es zählt für heute und hält deine Serie; tippe später im Tagebuch darauf, um Details zu ergänzen."
          }
        }
      }
    },
