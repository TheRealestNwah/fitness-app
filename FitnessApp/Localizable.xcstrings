        }
      }
    },
    "Shown in the food diary for foods that list them. Common guidance is at least 30 g of fibre, under 50 g of sugar and under 2,300 mg of sodium a day; ask your doctor if you're managing blood pressure or glucose." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en el diario para los alimentos que los indican. La recomendación habitual es al menos 30 g de fibra, menos de 50 g de azúcar y menos de 2300 mg de sodio al día; consulta a tu médico si controlas tu presión arterial o tu glucosa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird im Tagebuch für Lebensmittel angezeigt, die sie angeben. Übliche Empfehlung: mindestens 30 g Ballaststoffe, unter 50 g Zucker und unter 2300 mg Natrium pro Tag; frag deine Ärztin oder deinen Arzt, wenn du Blutdruck oder Blutzucker im Blick hast."
          }
        }
      }
    },
    "Sleep" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueño"
          }
        },
        "de" : {
