        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinkerinnerungen enden für den Tag, sobald du dein Ziel erreichst, und Mahlzeit-Erinnerungen überspringen bereits erfasste Mahlzeiten."
          }
        }
      }
    },
    "We've capped your target at %@, the lowest we recommend without medical supervision. Your loss may be a little slower than chosen." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
