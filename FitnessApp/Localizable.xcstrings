            "value" : "Sitzend"
          }
        }
      }
    },
    "Self-recorded at home with the Stride app. Not a medical record; readings are as entered by the patient." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrado en casa con la app Stride. No es un historial médico; los valores son los introducidos por el paciente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu Hause mit der App Stride selbst erfasst. Keine ärztliche Dokumentation; die Werte stammen von der Patientin oder dem Patienten."
          }
        }
      }
    },
    "Separate foods with commas or “and”. You can dictate with the microphone on the keyboard." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa los alimentos con comas o «y». Puedes dictar con el micrófono del teclado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne Lebensmittel mit Kommas oder „und“. Mit dem Mikrofon auf der Tastatur kannst du auch diktieren."
          }
        }
      }
    },
