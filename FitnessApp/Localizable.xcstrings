          }
        }
      }
    },
    "BMI is a rough guide only. A healthy range is 18.5–24.9." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC es solo una guía aproximada. El rango saludable es 18,5–24,9."
