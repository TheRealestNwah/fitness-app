          }
        }
      }
    },
    "Tap a vital to see its history. Readings are for your own tracking and are not medical advice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una constante para ver su historial. Los valores son para tu propio seguimiento y no son consejo médico."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Vitalwert, um den Verlauf zu sehen. Die Werte dienen deiner eigenen Übersicht und sind keine ärztliche Beratung."
          }
        }
      }
    },
    "Target %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetivo: %@"
          }
        },
        "de" : {
