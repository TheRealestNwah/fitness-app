    "Water reminders stop for the day once you reach your goal, and meal reminders skip meals you've already logged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios de agua se detienen al alcanzar tu objetivo del día, y los de comidas omiten las que ya registraste."
