          "stringUnit" : {
            "state" : "translated",
            "value" : "Calienta el aceite en una sartén antiadherente. Rehoga las espinacas y los tomates un minuto, añade los huevos batidos y revuelve suavemente. Sírvelo sobre la tostada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öl in einer beschichteten Pfanne erhitzen. Spinat und Tomaten eine Minute andünsten, verquirlte Eier zugeben und sanft stocken lassen. Auf Toast servieren."
