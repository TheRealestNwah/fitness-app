      }
    },
    "Track your weight, calories, vitals and meals in one place. Answer a few questions and we'll build a plan that fits you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla tu peso, calorías, constantes y comidas en un solo lugar. Responde unas preguntas y crearemos un plan a tu medida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte Gewicht, Kalorien, Vitalwerte und Mahlzeiten an einem Ort im Blick. Beantworte ein paar Fragen und wir erstellen einen passenden Plan."
          }
        }
