    "Same spot, same light and same time of day make the change easiest to see." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mismo sitio, la misma luz y la misma hora del día hacen que el cambio se vea mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicher Ort, gleiches Licht und gleiche Tageszeit machen die Veränderung am besten sichtbar."
          }
        }
      }
    },
    "Sauté garlic in oil, add tomatoes until they burst. Toss in shrimp and zucchini noodles for 2 minutes. Finish with parmesan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltea el ajo en aceite y añade los tomates hasta que revienten. Incorpora las gambas y los espaguetis de calabacín 2 minutos. Termina con parmesano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knoblauch in Öl anschwitzen, Tomaten zugeben, bis sie aufplatzen. Garnelen und Zucchininudeln 2 Minuten mitschwenken. Mit Parmesan vollenden."
          }
        }
      }
    },
