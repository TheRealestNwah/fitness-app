    "Sleep under 7 hours raises hunger hormones. Rest is part of the plan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormir menos de 7 horas aumenta las hormonas del hambre. Descansar es parte del plan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 7 Stunden Schlaf erhöhen die Hungerhormone. Ruhe gehört zum Plan."
          }
        }
      }
    },
    "Sleep, sodium and patterns" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
