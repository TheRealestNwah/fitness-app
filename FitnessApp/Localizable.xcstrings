          }
        }
      }
    },
    "Keeps your diary, weigh-ins, vitals and plans the same on every iPhone and iPad signed in to your Apple ID. Changes take effect the next time Stride starts. Turning it off keeps this device's copy." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene tu diario, pesajes, constantes y planes iguales en todos los iPhone y iPad con tu Apple ID. Los cambios se aplican la próxima vez que se abra Stride. Al desactivarlo se conserva la copia de este dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Tagebuch, Wägungen, Vitalwerte und Pläne auf allen iPhones und iPads mit deiner Apple-ID gleich. Änderungen wirken beim nächsten Start von Stride. Beim Ausschalten bleibt die Kopie auf diesem Gerät erhalten."
          }
        }
      }
    },
