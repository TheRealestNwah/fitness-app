            "value" : "Schlaf, Natrium und Muster"
          }
        }
      }
    },
    "Slice the apple and dip." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta la manzana en rodajas y mójala."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apfel in Spalten schneiden und dippen."
          }
        }
      }
    },
    "Slower is easier to stick to and keeps more muscle. Most people do best at 0.5 kg (about 1 lb) a week." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más despacio es más fácil de mantener y conserva más músculo. A la mayoría le va mejor con 0,5 kg (aprox. 1 lb) por semana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamer ist leichter durchzuhalten und erhält mehr Muskeln. Den meisten gelingen 0,5 kg (etwa 1 lb) pro Woche am besten."
          }
        }
      }
    },
