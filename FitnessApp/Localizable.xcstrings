    "Your calorie target is your maintenance, and Today warns you if your 7-day average drifts outside the band." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo de calorías es tu mantenimiento, y Hoy te avisa si tu media de 7 días se sale del margen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kalorienziel ist deine Erhaltung, und Heute warnt dich, wenn dein 7-Tage-Schnitt die Spanne verlässt."
          }
        }
      }
    },
    "Your current target already matches" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo actual ya coincide"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein aktuelles Ziel passt bereits"
          }
        }
      }
    },
    "Your data stays on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se quedan en este dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf diesem Gerät."
          }
        }
      }
    },
    "Your goal should be below your current weight." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo debe estar por debajo de tu peso actual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ziel sollte unter deinem aktuellen Gewicht liegen."
          }
        }
      }
    },
    "Your measured maintenance is about %@. A target of %@ matches your planned rate; you can apply it in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mantenimiento medido es de unas %@. Un objetivo de %@ se ajusta al ritmo previsto; puedes aplicarlo en Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gemessene Erhaltung liegt bei etwa %@. Ein Ziel von %@ passt zu deinem geplanten Tempo; du kannst es in den Einstellungen übernehmen."
          }
        }
      }
    },
