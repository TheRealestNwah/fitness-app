      }
    },
    "Works with most recipe sites. Ingredients come in without nutrition unless the page lists it; edit them in the recipe to add it from your food list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con la mayoría de webs de recetas. Los ingredientes llegan sin información nutricional salvo que la página la indique; edítalos en la receta para añadirla desde tu lista de alimentos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert mit den meisten Rezeptseiten. Zutaten kommen ohne Nährwerte, außer die Seite nennt sie; bearbeite sie im Rezept, um Werte aus deiner Lebensmittelliste zu ergänzen."
          }
        }
      }
    },
