          }
        }
      }
    },
    "Averaging %@ a day is well under any safe budget, so meals are probably missing. Log everything, including drinks, so the review means something." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una media de %@ al día está muy por debajo de cualquier presupuesto seguro, así que probablemente faltan comidas. Registra todo, bebidas incluidas, para que el resumen sea útil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Schnitt %@ pro Tag liegt weit unter jedem sicheren Budget, es fehlen also wohl Mahlzeiten. Erfasse alles, auch Getränke, damit der Rückblick etwas aussagt."
          }
        }
      }
    },
