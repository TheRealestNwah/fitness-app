    },
    "Your 7-day average has stayed around %@. Plateaus are normal; a few things worth checking:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu media de 7 días se ha mantenido en torno a %@. Los estancamientos son normales; conviene revisar algunas cosas:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein 7-Tage-Schnitt liegt seit einer Weile bei etwa %@. Plateaus sind normal; ein paar Dinge lohnen einen Blick:"
          }
        }
      }
    },
    "Your 7-day average passed %@ on %@. That's a real change, not a good morning." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
