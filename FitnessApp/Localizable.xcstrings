          }
        }
      }
    },
    "Search the food list to autofill" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en la lista de alimentos para rellenar"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Lebensmittelliste suchen, um auszufüllen"
          }
        }
      }
    },
    "Season and grill chicken 5–6 minutes a side. Slice over greens, tomatoes and cucumber. Crumble feta, dress with oil and lemon." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sazona el pollo y hazlo a la plancha 5–6 minutos por lado. Córtalo sobre la lechuga, los tomates y el pepino. Desmenuza el feta y aliña con aceite y limón."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hähnchen würzen und 5–6 Minuten pro Seite grillen. In Scheiben auf Salat, Tomaten und Gurke legen. Feta darüberbröseln, mit Öl und Zitrone anmachen."
          }
        }
      }
    },
    "Sedentary" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedentario"
          }
        },
        "de" : {
