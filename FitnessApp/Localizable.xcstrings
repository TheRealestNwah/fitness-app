          "stringUnit" : {
            "state" : "translated",
            "value" : "Número del código de barras"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barcode-Nummer"
          }
        }
      }
    },
    "Based on %lld logged days and %lld weigh-ins over the last %lld days: you averaged %@ and your weight moved %@ a week. Confidence: %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en %lld días registrados y %lld pesajes en los últimos %lld días: tu media fue %@ y tu peso cambió %@ por semana. Confianza: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basierend auf %lld erfassten Tagen und %lld Wägungen in den letzten %lld Tagen: Du lagst im Schnitt bei %@ und dein Gewicht änderte sich um %@ pro Woche. Verlässlichkeit: %@."
          }
        }
      }
    },
    "Blood pressure" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presión arterial"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blutdruck"
          }
        }
      }
    },
    "Blood pressure, resting heart rate, body measurements and sleep all respond to weight loss. Log them weekly to see the change." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presión arterial, la frecuencia cardiaca en reposo, las medidas y el sueño responden a la pérdida de peso. Regístralos cada semana para ver el cambio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blutdruck, Ruhepuls, Körpermaße und Schlaf reagieren alle auf Gewichtsverlust. Erfasse sie wöchentlich, um die Veränderung zu sehen."
          }
        }
      }
    },
    "Body" : {
