    "Walnuts" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueces"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walnüsse"
          }
        }
      }
    },
    "Water" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser"
          }
        }
      }
    },
    "Water and salt swing the scale by a kilo or two. Judge by the trend line and give it another week." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agua y la sal mueven la báscula uno o dos kilos. Fíjate en la línea de tendencia y date otra semana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser und Salz lassen die Waage um ein, zwei Kilo schwanken. Achte auf die Trendlinie und gib ihr noch eine Woche."
          }
        }
      }
    },
    "Water reminders" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorios de agua"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen ans Trinken"
          }
        }
      }
    },
    "Water reminders stop for the day once you reach your goal, and meal reminders skip meals you've already logged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios de agua se detienen al alcanzar tu objetivo del día, y los de comidas omiten las que ya registraste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinkerinnerungen enden für den Tag, sobald du dein Ziel erreichst, und Mahlzeit-Erinnerungen überspringen bereits erfasste Mahlzeiten."
          }
        }
      }
    },
    "Water retention from stress, sleep or new training can hide fat loss for a week or two." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retención de líquidos por estrés, sueño o un entrenamiento nuevo puede ocultar la pérdida de grasa una o dos semanas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wassereinlagerungen durch Stress, Schlaf oder neues Training können Fettverlust ein, zwei Wochen verdecken."
          }
        }
      }
    },
    "Watermelon" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandía"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wassermelone"
          }
        }
      }
    },
    "We've capped your target at %@, the lowest we recommend without medical supervision. Your loss may be a little slower than chosen." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos limitado tu objetivo a %@, el mínimo que recomendamos sin supervisión médica. Puede que pierdas peso algo más despacio de lo elegido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dein Ziel auf %@ begrenzt, das Minimum, das wir ohne ärztliche Begleitung empfehlen. Du nimmst vielleicht etwas langsamer ab als gewählt."
          }
        }
      }
    },
    "Weekly goal" : {
