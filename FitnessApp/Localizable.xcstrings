          }
        }
      }
    },
    "Auto-plan fills each meal with a recipe sized to your calorie target. You can swap anything afterwards." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La planificación automática llena cada comida con una receta ajustada a tu objetivo de calorías. Después puedes cambiar lo que quieras."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch planen füllt jede Mahlzeit mit einem Rezept passend zu deinem Kalorienziel. Du kannst danach alles austauschen."
          }
        }
      }
    },
    "Average intake" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
