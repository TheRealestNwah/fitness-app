    "Sweat onion, carrot and celery in oil. Add lentils, tomatoes and stock. Simmer 25 minutes until lentils are tender. Season well." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocha la cebolla, la zanahoria y el apio en aceite. Añade las lentejas, los tomates y el caldo. Cuece a fuego lento 25 minutos, hasta que las lentejas estén tiernas. Sazona bien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiebel, Karotte und Sellerie in Öl andünsten. Linsen, Tomaten und Brühe zugeben. 25 Minuten köcheln lassen, bis die Linsen weich sind. Gut abschmecken."
          }
        }
      }
