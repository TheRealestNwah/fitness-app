        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein 7-Tage-Schnitt hat am %2$@ die %1$@ unterschritten. Das ist eine echte Veränderung, kein guter Morgen."
          }
        }
      }
    },
    "Your average has held steady for %lld days." : {
      "localizations" : {
